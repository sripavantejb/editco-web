{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/reminders?slot=morning", "schedule": "30 3 * * *" },
    { "path": "/api/cron/reminders?slot=evening", "schedule": "30 12 * * *" },
